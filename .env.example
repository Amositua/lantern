# Copy to .env for local/docker-compose runs. Never commit the real .env.

ENVIRONMENT=local

# Vertex AI / Gemini
GCP_PROJECT_ID=
GCP_REGION=us-central1
VERTEX_LOCATION=us-central1
GEMINI_FLASH_MODEL=gemini-3.5-flash
GEMINI_PRO_MODEL=gemini-3.5-pro

# Firestore (Life Graph + case state)
FIRESTORE_DATABASE=(default)

# Cloud SQL + pgvector (RAG over user documents)
CLOUD_SQL_INSTANCE_CONNECTION_NAME=
CLOUD_SQL_DATABASE=lantern
CLOUD_SQL_USER=
CLOUD_SQL_PASSWORD=

# Pub/Sub (async re-engagement, delivery tracking)
PUBSUB_TOPIC_PREFIX=lantern

# External rails
PHARMACY_AGGREGATOR_BASE_URL=
PHARMACY_AGGREGATOR_API_KEY=
PAYSTACK_SECRET_KEY=

# Safety Router handoff -- NATIONAL_EMERGENCY_NUMBER defaults to Nigeria's 112.
# CRISIS_HOTLINE_NUMBER is deliberately blank: set it to a verified, current,
# local mental-health crisis line before any real deployment. Never guess one.
NATIONAL_EMERGENCY_NUMBER=112
CRISIS_HOTLINE_NUMBER=

# The dashboard's own origin -- Memory and Action allow browser requests from
# exactly this one origin, not "*"
DASHBOARD_ORIGIN=http://localhost:5173

# Service-to-service URLs (defaults match docker-compose; override for Cloud Run)
ORCHESTRATOR_URL=http://localhost:8080
PERCEPTION_URL=http://localhost:8081
CLARIFIER_URL=http://localhost:8082
ACTION_URL=http://localhost:8083
SAFETY_ROUTER_URL=http://localhost:8084
MEMORY_URL=http://localhost:8085
LIVE_SESSION_GATEWAY_URL=http://localhost:8086
