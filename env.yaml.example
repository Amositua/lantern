# Copy to env.yaml and fill in before running scripts/deploy.sh.
# Passed to `gcloud run deploy --env-vars-file`. Never commit the real file.

ENVIRONMENT: "production"
GCP_PROJECT_ID: ""
GCP_REGION: "us-central1"
VERTEX_LOCATION: "us-central1"
GEMINI_FLASH_MODEL: "gemini-3.5-flash"
GEMINI_PRO_MODEL: "gemini-3.5-pro"
FIRESTORE_DATABASE: "(default)"
CLOUD_SQL_INSTANCE_CONNECTION_NAME: ""
CLOUD_SQL_DATABASE: "lantern"
CLOUD_SQL_USER: ""
CLOUD_SQL_PASSWORD: ""
PUBSUB_TOPIC_PREFIX: "lantern"
PHARMACY_AGGREGATOR_BASE_URL: ""
PHARMACY_AGGREGATOR_API_KEY: ""
PAYSTACK_SECRET_KEY: ""
NATIONAL_EMERGENCY_NUMBER: "112"
# Verified, current, local mental-health crisis line -- never guess this one
CRISIS_HOTLINE_NUMBER: ""
# The deployed dashboard's own URL, once you have one
DASHBOARD_ORIGIN: ""
# Fill these in with the Cloud Run URLs gcloud prints after each deploy —
# a second deploy pass is normal since the URLs don't exist until the first.
ORCHESTRATOR_URL: ""
PERCEPTION_URL: ""
CLARIFIER_URL: ""
ACTION_URL: ""
SAFETY_ROUTER_URL: ""
MEMORY_URL: ""
LIVE_SESSION_GATEWAY_URL: ""
